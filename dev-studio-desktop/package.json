{
  "name": "dev-studio",
  "productName": "Dev Studio",
  "version": "1.7.0",
  "description": "Dev Studio \u2014 AI development studio for Windows: multi-model AI team, real terminal, official plugins, PIN-locked and audited, with a loopback bridge that opens the same workspace in Chrome.",
  "author": {
    "name": "Dev Studio",
    "email": "dev@studio.local"
  },
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node tools/sync-gamekit.mjs && vite build",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "test:logic": "node test/run.cjs",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:logic && npm run test:ui",
    "verify": "npm run test:logic && npm run test:ui",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@playwright/test": "^1.48.2",
    "@testing-library/react": "^14.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "jsdom": "^24.1.3",
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.8",
    "vitest": "^1.6.1"
  },
  "build": {
    "appId": "com.devstudio.desktop",
    "productName": "Dev Studio",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "plugins/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dev Studio"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
